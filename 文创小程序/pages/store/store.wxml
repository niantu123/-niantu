<!-- pages/store/store.wxml - 校园文创商店 -->
<view class="store-page">
  <!-- 商店头部 -->
  <view class="store-header">
    <view class="store-title">🛍️ 校园文创商店</view>
    <view class="store-sub">校庆限定 · 原创设计 · 校园自提</view>
  </view>

  <!-- 购物车 / 订单 快捷入口 -->
  <view class="quick-nav">
    <view class="quick-card cart-card" bindtap="goCart" hover-class="quick-hover" hover-stay-time="80">
      <view class="quick-icon">🛒</view>
      <view class="quick-info">
        <view class="quick-name">购物车</view>
        <view class="quick-sub">{{cartCount > 0 ? cartCount + ' 件商品待结算' : '先去逛逛吧'}}</view>
      </view>
      <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view class="quick-card" bindtap="goOrders" hover-class="quick-hover" hover-stay-time="80">
      <view class="quick-icon">🧾</view>
      <view class="quick-info">
        <view class="quick-name">我的订单</view>
        <view class="quick-sub">查看购物记录</view>
      </view>
      <text class="quick-arrow">></text>
    </view>
  </view>

  <!-- 推荐产品 -->
  <view class="goods-head">
    <view class="section-name">推荐产品</view>
    <view class="section-ops">
      <view class="shuffle-btn" bindtap="onShuffle" hover-class="shuffle-hover" hover-stay-time="80">换一批</view>
    </view>
  </view>

  <!-- 商品网格 -->
  <view class="goods-grid" wx:if="{{displayProducts.length > 0}}">
    <view class="goods-card" wx:for="{{displayProducts}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}" hover-class="card-hover" hover-stay-time="80">
      <image class="goods-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view class="goods-info">
        <view class="goods-name ellipsis">{{item.name}}</view>
        <view class="goods-bottom">
          <view class="goods-price" wx:if="{{item.sellable}}">
            <text class="price-symbol">¥</text><text class="price-num">{{item.price}}</text>
          </view>
          <view class="goods-price price-none" wx:else>价格待定</view>
          <view
            class="add-cart {{item.sellable ? '' : 'disabled'}}"
            wx:if="{{item.sellable}}"
            catchtap="onAddCart"
            data-id="{{item._id}}"
          >＋</view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && products.length === 0}}">
    <text class="empty-icon">🛍️</text>
    <text class="empty-text">商店暂无上架作品</text>
  </view>
</view>
