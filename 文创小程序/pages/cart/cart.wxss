/* pages/cart/cart.wxss - 购物车 */
.cart-page {
  min-height: 100vh;
  padding: 26rpx 30rpx 160rpx;
  box-sizing: border-box;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cart-item {
  position: relative;
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 58, 26, 0.06);
}

.cart-cover {
  width: 170rpx;
  height: 170rpx;
  border-radius: 14rpx;
  background: #f5f0ea;
  flex-shrink: 0;
}

.cart-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cart-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #3a2e22;
  line-height: 1.4;
}

.cart-price {
  margin-top: 8rpx;
  color: #ff6b35;
  font-size: 28rpx;
  font-weight: bold;
}

.cart-ops {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-box {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #f7f2ec;
  border-radius: 999rpx;
  padding: 4rpx;
}

.qty-btn {
  width: 46rpx;
  height: 46rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b5d4f;
  background: #fff;
  border-radius: 50%;
}

.qty-btn.plus {
  color: #ff6b35;
  font-weight: bold;
}

.qty-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #3a2e22;
}

.del-btn {
  font-size: 24rpx;
  color: #b8a99a;
  padding: 8rpx 12rpx;
}

.item-subtotal {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #3a2e22;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(93, 58, 26, 0.08);
}

.total-label {
  font-size: 26rpx;
  color: #6b5d4f;
}

.total-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b35;
}

.checkout-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.35);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #b8a99a;
  font-size: 26rpx;
  margin-bottom: 36rpx;
}

.go-store-btn {
  padding: 16rpx 52rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

/* 收货信息填单弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 20, 10, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ship-card {
  width: 86%;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 34rpx 34rpx;
  animation: shipIn 0.2s ease-out;
}

@keyframes shipIn {
  from { transform: scale(0.92); opacity: 0.4; }
  to { transform: scale(1); opacity: 1; }
}

.ship-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3a2e22;
  text-align: center;
}

.ship-summary {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b8a99a;
  text-align: center;
}

.ship-field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  background: #f7f2ec;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.ship-label {
  font-size: 26rpx;
  color: #6b5d4f;
  flex-shrink: 0;
}

.ship-input {
  flex: 1;
  font-size: 26rpx;
  color: #3a2e22;
}

.ship-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #b8a99a;
  text-align: center;
}

.ship-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}

.ship-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  text-align: center;
  font-size: 29rpx;
  border-radius: 999rpx;
}

.ship-btn.cancel {
  color: #6b5d4f;
  background: #f5f0ea;
}

.ship-btn.confirm {
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.3);
}
