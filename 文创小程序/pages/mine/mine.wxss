/* pages/mine/mine.wxss - 个人中心 */
.mine-page {
  min-height: 100vh;
  background: #faf7f3;
}

/* 用户头部 */
.user-header {
  padding: 40rpx 32rpx 44rpx;
  background: linear-gradient(150deg, #ff6b35 0%, #ff9a5a 60%, #ffb37e 100%);
  color: #fff;
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.25);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  background: #fff;
}

/* 点击更换头像 */
.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.avatar-wrap:active .avatar {
  opacity: 0.8;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #ff8c42;
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
}

.role {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
}

.arrow {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计 */
.stats {
  display: flex;
  margin-top: 36rpx;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 34rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 发布入口 */
.publish-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(60, 40, 20, 0.06);
}

.publish-title {
  font-size: 29rpx;
  font-weight: bold;
}

.publish-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.publish-btn {
  padding: 12rpx 32rpx;
  font-size: 25rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  border-radius: 30rpx;
}

/* 菜单 */
.menu {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(93, 58, 26, 0.07);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #faf6f1;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 34rpx;
  background: linear-gradient(145deg, #fff8f3, #ffe7d8);
  border-radius: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-value {
  font-size: 23rpx;
  color: #999;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 26rpx;
  color: #ccc;
}

/* 退出 */
.logout {
  margin: 32rpx 24rpx 0;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #ff4d4f;
  background: #fff;
  border-radius: 20rpx;
}
