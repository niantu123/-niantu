<!-- pages/list/list.wxml - 产品列表页 -->
<view class="list-page">
  <!-- 搜索与标签筛选 -->
  <view class="filter-header">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索作品名称"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
        confirm-type="search"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">✕</text>
    </view>
    <view class="tag-tabs">
      <view class="tag-tab {{currentTag === '' ? 'active' : ''}}" bindtap="onTagTap" data-tag="">全部</view>
      <view class="tag-tab {{currentTag === '热门' ? 'active' : ''}}" bindtap="onTagTap" data-tag="热门">热门</view>
      <view class="tag-tab {{currentTag === '新品' ? 'active' : ''}}" bindtap="onTagTap" data-tag="新品">新品</view>
    </view>
  </view>

  <view class="list-container">
    <!-- 左侧分类 -->
    <scroll-view class="sidebar" scroll-y>
      <view
        class="sidebar-item {{currentCategory === item.id ? 'active' : ''}}"
        wx:for="{{categoryList}}"
        wx:key="id"
        bindtap="onCategoryTap"
        data-id="{{item.id}}"
      >
        <text class="sidebar-icon">{{item.icon}}</text>
        <text class="sidebar-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧作品列表 -->
    <scroll-view class="content" scroll-y>
      <view class="product-list" wx:if="{{products.length > 0}}">
        <view
          class="product-card"
          wx:for="{{products}}"
          wx:key="_id"
          bindtap="onProductTap"
          data-id="{{item._id}}"
          hover-class="card-hover"
          hover-stay-time="80"
        >
          <image class="product-img" src="{{item.cover}}" mode="aspectFill"></image>
          <view class="product-info">
            <view class="product-name ellipsis-2">{{item.name}}</view>
            <view class="product-summary ellipsis">{{item.summary}}</view>
            <view class="product-tags">
              <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
            <view class="product-author ellipsis">作者：{{item.authorName}}</view>
          </view>
        </view>
      </view>

      <view class="empty" wx:elif="{{!loading}}">
        <text class="empty-icon">📦</text>
        <text class="empty-text">暂无相关文创作品</text>
      </view>
    </scroll-view>
  </view>
</view>
