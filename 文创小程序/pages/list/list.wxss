/* pages/list/list.wxss - 产品列表页 */
.list-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部筛选 */
.filter-header {
  background: #fff;
  padding: 16rpx 24rpx 0;
}

.search-box {
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 20rpx;
  background: #f7f3ee;
  border-radius: 34rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-clear {
  font-size: 24rpx;
  color: #999;
  padding: 0 8rpx;
}

.tag-tabs {
  display: flex;
  padding: 16rpx 0;
}

.tag-tab {
  padding: 8rpx 28rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #8a7a6d;
  background: #f7f3ee;
  border-radius: 26rpx;
}

.tag-tab.active {
  color: #fff;
  font-weight: bold;
  background: linear-gradient(135deg, #ff6b35, #ff9a5a);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.28);
}

/* 左右分栏 */
.list-container {
  flex: 1;
  display: flex;
  flex-wrap: nowrap;
  overflow: hidden;
  border-top: 1rpx solid #f2f2f2;
}

.sidebar {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 100%;
  background: #f7f3ee;
}

.sidebar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 130rpx;
  padding: 0 10rpx;
  font-size: 26rpx;
  color: #666;
  border-left: 6rpx solid transparent;
}

.sidebar-item.active {
  background: #fff;
  color: #ff6b35;
  border-left-color: #ff6b35;
  font-weight: bold;
  box-shadow: -4rpx 0 12rpx rgba(255, 140, 90, 0.08);
}

.sidebar-icon {
  font-size: 34rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.sidebar-name {
  font-size: 23rpx;
  line-height: 1;
  white-space: nowrap;
  text-align: center;
}

/* 右侧内容 */
.content {
  flex: 1;
  height: 100%;
  background: #fff;
  min-width: 0;
}

.product-list {
  padding: 20rpx;
}

.product-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 26rpx rgba(93, 58, 26, 0.07);
}

.product-img {
  flex: 0 0 200rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1.4;
}

.product-summary {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.product-tags {
  margin-top: 12rpx;
}

.product-author {
  margin-top: auto;
  font-size: 21rpx;
  color: #bbb;
}
