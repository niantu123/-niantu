/* pages/orders/orders.wxss - 我的订单 */
.orders-page {
  min-height: 100vh;
  padding: 26rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(93, 58, 26, 0.06);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f2ece4;
}

.order-no {
  font-size: 22rpx;
  color: #b8a99a;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.status-active {
  color: #ff6b35;
  background: #fff3ec;
}

.status-done {
  color: #07c160;
  background: #e8f9ef;
}

.status-cancel {
  color: #b8a99a;
  background: #f5f0ea;
}

.order-body {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0 8rpx;
  align-items: center;
}

.order-cover {
  width: 130rpx;
  height: 130rpx;
  border-radius: 14rpx;
  background: #f5f0ea;
  flex-shrink: 0;
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-items {
  font-size: 26rpx;
  color: #3a2e22;
  line-height: 1.5;
}

.order-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b8a99a;
}

.order-total {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.total-label {
  font-size: 22rpx;
  color: #b8a99a;
}

.total-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff6b35;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 18rpx;
}

.order-ship {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  background: #f7f2ec;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: #6b5d4f;
  line-height: 1.5;
}

.ship-emoji {
  margin-right: 4rpx;
}

.act-btn {
  padding: 12rpx 36rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.act-btn.ghost {
  color: #6b5d4f;
  background: #f5f0ea;
}

.act-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  font-weight: bold;
}

/* 删除订单按钮文字（红色提示危险操作） */
.danger-text {
  color: #e64340 !important;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #b8a99a;
  font-size: 26rpx;
  margin-bottom: 36rpx;
}

.go-store-btn {
  padding: 16rpx 52rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

/* 取消订单弹窗（与全站弹窗风格一致） */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.modal-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 30rpx 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3a2e22;
  text-align: center;
}

.modal-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #b8a99a;
  text-align: center;
}

.modal-textarea {
  width: 100%;
  min-height: 140rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  background: #faf7f3;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #3a2e22;
  box-sizing: border-box;
}

.modal-placeholder { color: #c4b8a9; }

.modal-count {
  text-align: right;
  font-size: 22rpx;
  color: #c4b8a9;
  margin-top: 8rpx;
}

.quick-title {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8a7a68;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.quick-chip {
  padding: 10rpx 22rpx;
  background: #fff3ec;
  border: 1rpx solid #ffc9ad;
  color: #ff6b35;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.modal-btn.cancel {
  background: #f5f0ea;
  color: #6b5d4f;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
}
