/* pages/author-orders/author-orders.wxss - 收到的订单（作者视角） */
.orders-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-hint {
  padding: 24rpx 30rpx 0;
  font-size: 23rpx;
  color: #b8a99a;
}

.order-list {
  padding: 24rpx 30rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(93, 58, 26, 0.06);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 28rpx;
  font-weight: bold;
  color: #3a2e22;
}

.order-status {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.status-active {
  background: #fff3ec;
  color: #ff6b35;
}

.status-done {
  background: #e8f8ef;
  color: #07c160;
}

.status-cancel {
  background: #f5f0ea;
  color: #a2937f;
}

.order-body {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.order-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  background: #f5f0ea;
  flex-shrink: 0;
}

.order-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.order-items {
  font-size: 26rpx;
  color: #3a2e22;
  line-height: 1.5;
}

.order-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b8a99a;
}

.order-total {
  text-align: right;
  flex-shrink: 0;
}

.total-label {
  display: block;
  font-size: 20rpx;
  color: #b8a99a;
}

.total-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff6b35;
}

.order-ship {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #a2937f;
  word-break: break-all;
}

/* 取消原因引用块 */
.cancel-reason {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  background: #fff5f4;
  border: 1rpx solid #ffd9d5;
  border-radius: 14rpx;
}

.cancel-title {
  font-size: 23rpx;
  font-weight: bold;
  color: #c2564e;
}

.cancel-text {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #3a2e22;
  line-height: 1.6;
}

.cancel-time {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #b8a99a;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #b8a99a;
  font-size: 26rpx;
}

.go-store-btn {
  margin-top: 30rpx;
  padding: 18rpx 60rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  font-size: 27rpx;
  font-weight: bold;
  border-radius: 999rpx;
}
