/* pages/my-works/my-works.wxss */
.works-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f5f5;
}

.work-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(60, 40, 20, 0.05);
}

.work-head {
  display: flex;
}

.work-cover {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
}

.work-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.work-name {
  font-size: 29rpx;
  font-weight: bold;
}

.work-summary {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #999;
  line-height: 1.5;
}

.work-meta {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.work-time {
  font-size: 20rpx;
  color: #bbb;
}

.reject-reason {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  font-size: 23rpx;
  color: #cf1322;
  background: #fff1f0;
  border-radius: 10rpx;
}

.work-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  margin-left: 16rpx;
  padding: 10rpx 34rpx;
  font-size: 24rpx;
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
  border-radius: 26rpx;
}

.action-btn.danger {
  color: #999;
  border-color: #ddd;
}

.go-btn {
  padding: 16rpx 48rpx;
  font-size: 26rpx;
}

/* 订单提醒条 */
.order-hint {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 8rpx;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #fff3ec, #ffe9db);
  border: 1rpx solid #ffc9ad;
  border-radius: 18rpx;
}

.hint-hover {
  transform: scale(0.98);
}

.hint-main {
  flex: 1;
  min-width: 0;
}

.hint-title {
  font-size: 27rpx;
  font-weight: bold;
  color: #3a2e22;
}

.hint-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  font-size: 20rpx;
  font-weight: normal;
  border-radius: 999rpx;
  vertical-align: middle;
}

.hint-tag.cancel {
  background: #c2564e;
}

.hint-reason {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #c2564e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hint-arrow {
  margin-left: 16rpx;
  color: #c98b62;
  font-size: 34rpx;
  flex-shrink: 0;
}
