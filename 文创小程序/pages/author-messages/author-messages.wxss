/* pages/author-messages/author-messages.wxss - 收到的咨询（作者视角） */
.inq-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.inq-list {
  padding: 24rpx 30rpx;
}

.inq-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(93, 58, 26, 0.06);
}

.inq-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.inq-user {
  font-size: 28rpx;
  font-weight: bold;
  color: #3a2e22;
}

.inq-status {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.inq-status.done {
  background: #e8f8ef;
  color: #07c160;
}

.inq-status.pending {
  background: #fff3ec;
  color: #ff6b35;
}

.inq-product {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #a2937f;
}

.inq-content {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #3a2e22;
  line-height: 1.6;
}

.inq-contact {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #a2937f;
}

.inq-reply {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff7ef;
  border: 1rpx solid #ffd9b8;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #b25b2e;
  line-height: 1.6;
}

.inq-reply-label {
  font-weight: bold;
}

.inq-reply-time {
  color: #b8a99a;
  font-size: 21rpx;
}

.inq-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.inq-time {
  font-size: 22rpx;
  color: #b8a99a;
}

.inq-reply-btn {
  padding: 10rpx 28rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 999rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #b8a99a;
  font-size: 26rpx;
}

.go-store-btn {
  margin-top: 30rpx;
  padding: 18rpx 60rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  font-size: 27rpx;
  font-weight: bold;
  border-radius: 999rpx;
}

/* 回复弹窗（与全站弹窗风格一致） */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.modal-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 30rpx 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3a2e22;
  text-align: center;
}

.modal-textarea {
  width: 100%;
  min-height: 140rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  background: #faf7f3;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #3a2e22;
  box-sizing: border-box;
}

.modal-placeholder { color: #c4b8a9; }

.modal-count {
  text-align: right;
  font-size: 22rpx;
  color: #c4b8a9;
  margin-top: 8rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.modal-btn.cancel {
  background: #f5f0ea;
  color: #6b5d4f;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
}
