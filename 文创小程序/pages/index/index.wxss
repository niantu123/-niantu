/* pages/index/index.wxss - 首页 */
.index-page {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx 26rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff9a5a 60%, #ffb37e 100%);
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.22);
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 10rpx 0 26rpx;
  background: #fff;
  border-radius: 38rpx;
  box-shadow: 0 4rpx 14rpx rgba(120, 60, 20, 0.12);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-btn {
  padding: 10rpx 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff9a5a);
  border-radius: 30rpx;
}

.search-placeholder {
  color: #c4b8ab;
}

/* 公告 */
.notice-bar {
  display: flex;
  align-items: center;
  height: 68rpx;
  margin: 16rpx 24rpx 0;
  padding: 0 20rpx;
  background: #fff8ef;
  border-radius: 12rpx;
}

.notice-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.notice-swiper {
  flex: 1;
  height: 68rpx;
}

.notice-text {
  display: block;
  line-height: 68rpx;
  font-size: 24rpx;
  color: #b26a2a;
}

/* 轮播 */
.banner {
  height: 320rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(255, 107, 53, 0.14);
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 30rpx 24rpx 20rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
}

.banner-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.banner-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 分类导航 */
.category-nav {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 24rpx 0;
  padding: 16rpx 0;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(60, 40, 20, 0.05);
}

.category-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.category-icon {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(145deg, #fff8f3, #ffe7d8);
  border-radius: 28rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 6rpx 14rpx rgba(255, 140, 90, 0.18);
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

/* 区块 */
.section {
  margin-top: 18rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3d2b1f;
  line-height: 1.2;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 热门横滑 */
.hot-scroll {
  white-space: nowrap;
}

.hot-list {
  display: flex;
  padding: 0 24rpx;
}

.hot-item {
  width: 240rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 6rpx 20rpx rgba(60, 40, 20, 0.06);
}

.hot-img {
  width: 240rpx;
  height: 240rpx;
  display: block;
}

.hot-name {
  padding: 12rpx 16rpx 0;
  font-size: 26rpx;
  font-weight: bold;
}

.hot-author {
  padding: 6rpx 16rpx 16rpx;
  font-size: 22rpx;
  color: #999;
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.product-item {
  width: calc(50% - 16rpx);
  margin: 0 8rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(60, 40, 20, 0.06);
}

.product-img {
  width: 100%;
  height: 330rpx;
  display: block;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1.4;
  min-height: 39rpx;
}

.product-summary {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

/* 浏览量小胶囊：与详情页同风格 */
.view-chip {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  font-size: 18rpx;
  color: #b26a2a;
  background: linear-gradient(145deg, #fff8f3, #ffe7d8);
  border-radius: 18rpx;
}

.view-emoji {
  margin-right: 4rpx;
  font-size: 18rpx;
}

/* 文创助手悬浮入口 */
.assistant-fab {
  position: fixed;
  right: 28rpx;
  bottom: 180rpx;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.25);
  border: 1rpx solid #ffd9c2;
}

.fab-hover {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 40rpx;
  line-height: 1.1;
}

.fab-text {
  font-size: 18rpx;
  color: #b26a2a;
  margin-top: 2rpx;
}
