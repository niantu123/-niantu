<!-- pages/feedback/feedback.wxml - 意见反馈 -->
<view class="feedback-page">
  <!-- 提交反馈 -->
  <view class="form-card">
    <view class="form-title">反馈类型</view>
    <view class="type-row">
      <view class="type-chip {{type === '意见' ? 'active' : ''}}" bindtap="pickType" data-type="意见">💡 意见建议</view>
      <view class="type-chip {{type === '问题' ? 'active' : ''}}" bindtap="pickType" data-type="问题">❓ 问题反馈</view>
    </view>

    <view class="form-title">反馈内容</view>
    <textarea
      class="content-input"
      placeholder="对平台的意见建议，或使用中遇到的问题，都可以告诉我们～"
      maxlength="300"
      value="{{content}}"
      bindinput="onContentInput"
    ></textarea>
    <view class="counter">{{content.length}}/300</view>

    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}">提交反馈</button>

    <view class="login-tip" wx:if="{{!user}}">
      提交反馈前需要 <text class="link" bindtap="goLogin">登录</text>
    </view>
  </view>

  <!-- 我的反馈 -->
  <view class="history">
    <view class="history-title" wx:if="{{user}}">我的反馈</view>
    <view class="fb-list" wx:if="{{user && list.length > 0}}">
      <view class="fb-card" wx:for="{{list}}" wx:key="_id">
        <view class="fb-head">
          <view class="fb-tags">
            <text class="fb-type {{item.type === '问题' ? 'q' : 's'}}">{{item.type}}</text>
            <text class="fb-type {{item.status === '已处理' ? 'done' : 'wait'}}">{{item.status || '待处理'}}</text>
          </view>
          <text class="fb-time">{{item.timeText}}</text>
        </view>
        <view class="fb-content">{{item.content}}</view>
        <view class="fb-reply" wx:if="{{item.reply}}">
          <view class="fb-reply-title">✉️ 管理员回复</view>
          <view class="fb-reply-text">{{item.reply}}</view>
        </view>
        <view class="fb-ops">
          <view class="fb-op edit" catchtap="openEdit" data-id="{{item._id}}">编辑</view>
          <view class="fb-op del" catchtap="onDeleteFeedback" data-id="{{item._id}}">删除</view>
        </view>
      </view>
    </view>
    <view class="fb-empty" wx:if="{{user && list.length === 0}}">还没有提交过反馈</view>
    <view class="fb-empty" wx:if="{{!user}}">
      登录后可提交反馈并查看记录 · <text class="link" bindtap="goLogin">去登录</text>
    </view>
  </view>

  <!-- 编辑反馈弹窗 -->
  <view class="modal-mask" wx:if="{{editVisible}}" catchtap="closeEdit" catchtouchmove="noop">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">编辑反馈</view>
      <view class="modal-sub">修改后管理员将重新查看你的反馈</view>
      <textarea
        class="modal-textarea"
        maxlength="300"
        value="{{editContent}}"
        bindinput="onEditInput"
      ></textarea>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="closeEdit">取消</view>
        <view class="modal-btn confirm" bindtap="confirmEdit">保存</view>
      </view>
    </view>
  </view>
</view>
