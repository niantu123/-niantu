/* pages/publish/publish.wxss - 作者发布 */
.publish-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f5f5;
}

.tip-banner {
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 23rpx;
  color: #b26a2a;
  background: #fff8ef;
  border-radius: 12rpx;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(60, 40, 20, 0.05);
}

.form-title {
  font-size: 29rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.required {
  color: #ff4d4f;
  font-size: 24rpx;
}

.form-sub {
  font-size: 21rpx;
  color: #bbb;
  font-weight: normal;
  margin-left: 12rpx;
}

/* 图片 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
}

.image-item,
.image-add {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f8f8f8;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.add-icon {
  font-size: 48rpx;
  color: #ccc;
  line-height: 1.2;
}

.add-text {
  font-size: 21rpx;
  color: #bbb;
}

/* 表单字段 */
.field-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.field-label {
  flex: 0 0 180rpx;
  font-size: 26rpx;
  color: #555;
}

/* 一句话简介标题行：标签 + AI 按钮 */
.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label-row .field-label {
  flex: 1;
}

.ai-btn {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff9a5a);
  border-radius: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.25);
}

.ai-btn-hover {
  opacity: 0.85;
  transform: scale(0.96);
}

.ai-btn.disabled {
  opacity: 0.45;
}

.ai-btn-icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.field-input {
  flex: 1;
  font-size: 26rpx;
  text-align: right;
}

.field-picker {
  flex: 1;
}

.picker-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
}

.picker-arrow {
  color: #ccc;
  margin-left: 8rpx;
}

.field-column {
  padding: 20rpx 0;
}

.field-column .field-label {
  display: block;
  margin-bottom: 14rpx;
}

.field-textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.field-textarea.small {
  height: 140rpx;
}

.counter {
  text-align: right;
  font-size: 21rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.submit-btn {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 10rpx 0;
}

.submit-btn::after {
  border: none;
}
