/* pages/assistant/assistant.wxss - 文创产品助手 */
.assistant-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.chat-area {
  flex: 1;
  min-height: 0;
}

.chat-list {
  padding: 24rpx 24rpx 0;
}

.chat-pad {
  height: 24rpx;
}

.row {
  display: flex;
  margin-bottom: 28rpx;
}

.row.left {
  justify-content: flex-start;
}

.row.right {
  justify-content: flex-end;
}

/* 头像 */
.avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.bot-avatar {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  margin-right: 16rpx;
}

.user-avatar {
  background: #ffe9db;
  margin-left: 16rpx;
}

/* 气泡 */
.bubble {
  max-width: 76%;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.65;
  border-radius: 22rpx;
  box-sizing: border-box;
  word-break: break-all;
}

.bubble.bot {
  color: #333;
  background: #fff;
  border-top-left-radius: 6rpx;
  box-shadow: 0 4rpx 14rpx rgba(60, 40, 20, 0.05);
}

.bubble.user {
  color: #fff;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  border-top-right-radius: 6rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.25);
}

.bot-text {
  white-space: pre-line;
}

/* 作品卡片 */
.product-list {
  margin-top: 16rpx;
}

.product-card {
  display: flex;
  align-items: center;
  padding: 14rpx;
  margin-bottom: 14rpx;
  background: #faf8f6;
  border-radius: 16rpx;
}

.card-hover {
  background: #f2ede8;
}

.p-cover {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.p-info {
  flex: 1;
  min-width: 0;
  padding: 0 14rpx;
}

.p-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.p-summary {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #999;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.p-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #ccc;
}

/* 思考动画 */
.typing {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  background: #c9c9c9;
  border-radius: 50%;
  animation: blink 1s infinite;
}

.dot.d2 {
  animation-delay: 0.2s;
}

.dot.d3 {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 1; }
}

/* 快捷问题 */
.quick-bar {
  flex-shrink: 0;
  display: flex;
  padding: 16rpx 20rpx;
  white-space: nowrap;
  background: #f5f5f5;
}

.quick-chip {
  flex-shrink: 0;
  margin-right: 14rpx;
  padding: 10rpx 24rpx;
  font-size: 23rpx;
  color: #b26a2a;
  background: #fff6ef;
  border: 1rpx solid #ffd9c2;
  border-radius: 26rpx;
}

.quick-chip:active {
  background: #ffe9db;
}

/* 输入栏 */
.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(60, 40, 20, 0.05);
}

/* 联网开关 */
.online-toggle {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 72rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #f5f5f5;
  opacity: 0.55;
}

.online-toggle.on {
  background: #e8f5e9;
  opacity: 1;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.2);
}

.online-toggle .toggle-icon {
  font-size: 30rpx;
  line-height: 1.1;
}

.online-toggle .toggle-text {
  font-size: 17rpx;
  color: #666;
  margin-top: 2rpx;
}

.online-toggle.on .toggle-text {
  color: #2e7d32;
  font-weight: bold;
}

.toggle-hover {
  opacity: 0.4;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #fff;
  background: #d8d8d8;
  border-radius: 36rpx;
}

.send-btn.active {
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  box-shadow: 0 6rpx 14rpx rgba(255, 107, 53, 0.3);
}
