/* pages/login/login.wxss - 登录注册 */
.login-page {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(170deg, #fff3eb 0%, #f5f5f5 45%);
  box-sizing: border-box;
}

.brand {
  text-align: center;
  margin-bottom: 48rpx;
}

.brand-icon {
  font-size: 88rpx;
}

.brand-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.login-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 53, 0.08);
}

.mode-tabs {
  display: flex;
  margin-bottom: 32rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding-bottom: 20rpx;
  font-size: 27rpx;
  color: #999;
  position: relative;
}

.mode-tab.active {
  color: #ff6b35;
  font-weight: bold;
}

.mode-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  background: #ff6b35;
  border-radius: 3rpx;
}

.panel {
  padding-top: 8rpx;
}

.wechat-tip {
  font-size: 25rpx;
  color: #888;
  line-height: 1.8;
  margin-bottom: 36rpx;
}

.wechat-btn {
  margin-top: 8rpx;
}

.field {
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  font-size: 27rpx;
  background: #f8f8f8;
  border-radius: 14rpx;
}

/* 密码输入行：flex 并排，眼睛独立不与输入框重叠，避免原生组件拦截点击 */
.field-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.field-row .field {
  flex: 1;
  width: auto;
  min-width: 0;
  margin-bottom: 0;
}

/* 小眼睛：闭眼显示黑点密文，睁眼显示明文 */
.eye {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-left: 10rpx;
  padding: 6rpx;
  box-sizing: border-box;
}

.eye-hover {
  opacity: 0.55;
}

.eye-outline {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 8rpx;
  height: 24rpx;
  border: 3rpx solid #c08a5a;
  border-radius: 50%;
  box-sizing: border-box;
  transform: scaleY(1);
  transform-origin: center;
  transition: transform 0.25s ease;
}

.eye-pupil {
  position: absolute;
  left: 50%;
  top: 20rpx;
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 0 0 -5rpx;
  background: #c08a5a;
  border-radius: 50%;
  transition: opacity 0.2s ease;
}

.eye-lash {
  position: absolute;
  top: 26rpx;
  width: 3rpx;
  height: 9rpx;
  background: #c08a5a;
  border-radius: 2rpx;
  transform-origin: top center;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.lash-1 {
  left: 6rpx;
  transform: rotate(38deg);
}

.lash-2 {
  left: 18rpx;
  transform: rotate(0deg);
}

.lash-3 {
  left: 30rpx;
  transform: rotate(-38deg);
}

/* 闭合：眼睑压扁成一条线，睫毛张开 */
.eye.closed .eye-outline {
  transform: scaleY(0.18);
}

.eye.closed .eye-pupil {
  opacity: 0;
}

.eye.closed .eye-lash {
  opacity: 1;
}

button.btn-primary {
  margin-top: 12rpx;
}

.admin-hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}

.agreement {
  margin-top: 48rpx;
  text-align: center;
  font-size: 21rpx;
  color: #bbb;
}
